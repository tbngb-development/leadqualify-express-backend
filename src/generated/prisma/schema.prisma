// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  apiKey    String   @unique @default(uuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  campaigns    Campaign[]
  leads        Lead[]
  calls        Call[]
  assistants   Assistant[]
  brochures    Brochure[]
  callAnalyses CallAnalysis[]
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSISTANT
// ─────────────────────────────────────────────────────────────────────────────

model Assistant {
  id        String   @id @default(uuid())
  bolnaId   String
  name      String
  tenantId  String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  campaigns Campaign[]
}

// ─────────────────────────────────────────────────────────────────────────────
// BROCHURE
// ─────────────────────────────────────────────────────────────────────────────

model Brochure {
  id       String @id @default(uuid())
  tenantId String

  originalFileName String
  fileSizeMB       String
  pageCount        Int
  rawTextLength    Int

  projectName    String?
  developerName  String?
  reraNumber     String?
  projectWebsite String?
  contactNumber  String?

  city        String?
  area        String?
  state       String?
  landmark    String?
  fullAddress String?

  propertyTypes  String[]
  configurations String[]
  totalUnits     Int?
  totalTowers    Int?
  totalFloors    Int?
  sizeMin        Float?
  sizeMax        Float?
  sizeUnit       String?

  startingPrice     Float?
  maxPrice          Float?
  pricePerSqft      Float?
  priceLabel        String?
  paymentPlan       String?
  bankApprovals     String[]
  maintenanceCharge String?

  possessionDate     String?
  launchDate         String?
  constructionStatus String? @default("unknown")

  amenities            String[]
  specifications       String[]
  nearbyInfrastructure String[]
  usps                 String[]

  minimumBudget          Float?
  maximumBudget          Float?
  targetBuyerProfile     String?
  preferredLocations     String[]
  investmentType         String[]
  keyQualifyingQuestions String[]

  confidence         Float    @default(0)
  extractionWarnings String[]

  isConfirmed Boolean   @default(false)
  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  campaigns Campaign[]

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CAMPAIGN
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id           String         @id @default(uuid())
  name         String
  description  String?
  status       CampaignStatus @default(DRAFT)
  tenantId     String
  assistantId  String
  brochureId   String?
  variables    Json?
  totalLeads   Int            @default(0)
  calledLeads  Int            @default(0)
  successLeads Int            @default(0)
  failedLeads  Int            @default(0)
  scheduledAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  startedAt    DateTime?
  completedAt  DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  assistant Assistant @relation(fields: [assistantId], references: [id])
  brochure  Brochure? @relation(fields: [brochureId], references: [id])
  leads     Lead[]
  calls     Call[]

  @@index([brochureId])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAD
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id         String     @id @default(uuid())
  name       String?
  phone      String
  email      String?
  company    String?
  status     LeadStatus @default(PENDING)
  doNotCall  Boolean    @default(false)
  tenantId   String
  campaignId String
  metadata   Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])
  calls    Call[]

  // One phone number per campaign — prevents duplicate leads
  // @@unique([phone, campaignId])
  @@index([tenantId])
  @@index([campaignId])
}

enum LeadStatus {
  PENDING
  CALLING
  CALLED
  QUALIFIED
  NOT_QUALIFIED
  NO_ANSWER
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────────
// CALL
// ─────────────────────────────────────────────────────────────────────────────

model Call {
  id                 String     @id @default(uuid())
  bolnaCallId        String?    @unique
  tenantId           String
  campaignId         String
  leadId             String
  status             CallStatus @default(PENDING)
  duration           Int?
  recording          String?
  transcript         String?
  transcriptMessages Json?
  summary            String?
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  campaign     Campaign      @relation(fields: [campaignId], references: [id])
  lead         Lead          @relation(fields: [leadId], references: [id])
  callAnalysis CallAnalysis?

  @@index([tenantId])
  @@index([campaignId])
  @@index([leadId])
}

enum CallStatus {
  PENDING
  CALLING
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
}

// ─────────────────────────────────────────────────────────────────────────────
// CALL ANALYSIS
// ─────────────────────────────────────────────────────────────────────────────

model CallAnalysis {
  id       String @id @default(uuid())
  callId   String @unique
  tenantId String

  disposition             Disposition?
  leadTemperature         LeadTemperature?
  preferredConfiguration  String?
  budgetRange             String?
  purchaseTimeline        PurchaseTimeline?
  purchasePurpose         PurchasePurpose?
  locationMatch           LocationMatch?
  customerLocationPref    String?
  preferredNextAction     PreferredNextAction?
  preferredContactChannel ContactChannel?
  followupSchedule        String?
  doNotCall               ExtractionFlag?
  languageSupportRequired ExtractionFlag?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  call   Call   @relation(fields: [callId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([callId])
  @@index([disposition])
  @@index([leadTemperature])
}

// ─────────────────────────────────────────────────────────────────────────────
// CALL ANALYSIS ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Disposition {
  INTERESTED_SEND_DETAILS
  QUALIFIED_CONSULTANT_FOLLOWUP
  SITE_VISIT_INTEREST
  INTERESTED_GENERAL
  FOLLOWUP_REQUESTED
  NOT_INTERESTED
  DO_NOT_CALL
  WRONG_NUMBER
  ALREADY_PURCHASED
  BROKER
  LANGUAGE_CALLBACK_REQUIRED
  CALL_ENDED_BY_CUSTOMER
  CALL_ENDED_ABUSIVE
  NO_RESPONSE
  CALL_DROPPED
}

enum LeadTemperature {
  HOT
  WARM
  NURTURE
  COLD
  NOT_APPLICABLE
}

enum PurchaseTimeline {
  WITHIN_3_MONTHS
  WITHIN_6_MONTHS
  WITHIN_1_YEAR
  AFTER_1_YEAR
  FLEXIBLE
  NOT_SHARED
}

enum PurchasePurpose {
  OWN_USE
  INVESTMENT
  BOTH
  NOT_SHARED
}

enum PreferredNextAction {
  SEND_DETAILS
  CONSULTANT_CALL
  SITE_VISIT
  FOLLOWUP_CALL
  NONE
}

enum ContactChannel {
  WHATSAPP
  EMAIL
  NOT_ASKED
}

enum LocationMatch {
  MATCH
  MISMATCH
  NOT_ASKED
  NOT_MENTIONED
}

enum ExtractionFlag {
  YES
  NO
}
